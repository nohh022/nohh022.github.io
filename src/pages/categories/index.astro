---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { PLATFORMS } from "../../constants";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = await getCollection("blog");
---

<Layout title={`Categories | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Categorías" pageDesc="Todas las categorías">
    <section class="mt-8 space-y-2 font-mono">
  {PLATFORMS.map(platform => {
    const platformPosts = posts.filter(post => post.data.platform === platform);
    
    return (
      <details class="group">
        <summary class="flex cursor-pointer items-center gap-2 py-1 text-skin-accent list-none">
          <span class="group-open:rotate-90 transition-transform text-[0.6rem]">▶</span>
          <span class="font-bold uppercase tracking-widest">{platform}</span>
        </summary>

        <ul class="ml-4 border-l border-skin-line/30">
          {platformPosts.map(post => (
            <li class="relative py-1 pl-6 before:absolute before:left-0 before:top-1/2 before:h-px before:w-4 before:bg-skin-line/30">
              <a 
                href={`/posts/${post.data.slug}`} 
                class="hover:text-[#5994ae] transition-colors"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    );
  })}
</section>
  </Main>
  <Footer />
</Layout>
